# Create .env only if it does not already exist, then fill in your keys:
#   cp -n .env.example .env
# NEVER commit your actual .env file to Git!

OPENROUTER_API_KEY=sk-or-v1-replace-with-your-key

# Live coaching sends the text you submit to OpenRouter and this model provider.
# An API account/key is separate from a Claude chat subscription.
# The fictional walkthrough works without a key and makes no API requests.
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6

# Optional override for an existing reviewed Body of Work guide (absolute path).
# Default: ~/.config/ai-coach/body-of-work-v1.json
# This is a private versioned guide, not the full book; it is not in a fresh clone.
# Missing guide: fictional workshop remains available, personal workshop is disabled.
# BODY_OF_WORK_SOURCE_PATH=/absolute/path/to/body-of-work-v1.json
